# Copy to .env and fill in. Never commit .env.
# Trading212: Settings > API (Beta) in the app. Create separate key pairs for demo and live.
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=
T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=

# Alpaca market data (paper or live account keys both work for data)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Anthropic Console API key (used from phase 3 onwards)
ANTHROPIC_API_KEY=
